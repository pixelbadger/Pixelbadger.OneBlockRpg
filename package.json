{
  "name": "@pixelbadger/oneblock-rpg",
  "version": "0.1.0",
  "description": "A one block CRPG: a TypeScript text adventure engine with LLM-driven characters on a deterministic simulation.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "oneblock": "./bin/oneblock.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pure.json",
    "format": "biome check --write .",
    "schema": "tsx src/hosts/cli/main.ts schema --out schema/payload.schema.json",
    "oneblock": "tsx src/hosts/cli/main.ts",
    "art": "tsx tools/art.ts",
    "web": "tsx tools/web.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kmamal/sdl": "^0.11.13",
    "@napi-rs/canvas": "^1.0.10",
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "preact": "^11.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@kmamal/sdl",
      "esbuild"
    ]
  }
}
