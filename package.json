{
  "name": "@pixelbadger/oneblock-rpg",
  "version": "0.1.0",
  "description": "A one block CRPG: a TypeScript text adventure engine with LLM-driven characters on a deterministic simulation.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "oneblock": "./bin/oneblock.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check . && tsc -p tsconfig.json --noEmit",
    "format": "biome check --write .",
    "schema": "tsx src/cli/main.ts schema --out schema/payload.schema.json",
    "oneblock": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.131.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
